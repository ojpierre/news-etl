# NewsAPI Credentials (https://newsapi.org)
NEWS_API_KEY=your_news_api_key_here

# Database Configuration
# Supports SQLite (default for zero-setup local dev) or PostgreSQL
DATABASE_URL=sqlite:///news_articles.db

# Alternative granular PostgreSQL settings (used if DATABASE_URL is unset)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=news_db
